{
  "name": "videohost-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "turbo run build",
    "build:all": "turbo run build",
    "build:web": "turbo run build --filter=@videohost/web",
    "build:worker": "turbo run build --filter=@videohost/worker",
    "dev": "turbo run dev --filter=@videohost/web",
    "dev:worker": "npm run dev --prefix apps/worker",
    "dev:all": "turbo run dev",
    "start:web": "npm run start --prefix apps/web",
    "start:worker": "npm run start --prefix apps/worker",
    "lint": "turbo run lint",
    "db:generate": "npm run --prefix packages/db generate",
    "db:push": "npm run --prefix packages/db push",
    "db:seed": "npm run --prefix packages/db seed",
    "test:worker": "node scripts/test-worker.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
