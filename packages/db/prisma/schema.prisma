generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------
// Auth.js Standard Models (NextAuth v5)
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  viewMode             String               @default("CREATOR") // "CREATOR" | "VIEWER"
  activeOrganizationId String?
  isBlocked            Boolean              @default(false)
  blockedReason        String?
  blockedAt            DateTime?
  accounts             Account[]
  sessions      Session[]
  memberships   OrganizationMember[]
  createdApiKeys ApiKey[]
  paymentOrders PaymentOrder[]
  createdMeetings Meeting[]
  contentPurchases ContentPurchase[]
  withdrawalRequests WithdrawalRequest[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------------------------
// Organization & Access Control
// --------------------------------------------------------

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  coverUrl             String?
  themeId              String   @default("lime")
  planId               String
  plan                 Plan     @relation(fields: [planId], references: [id])
  customMinutesLimit   Int?     // overrides plan.minutesLimit when set
  customStorageLimitGb Int?
  planExpiresAt        DateTime?
  billingMode          String   @default("ONE_TIME") // "ONE_TIME" | "RECURRING"
  billingCycle         String   @default("MONTHLY")  // "MONTHLY" | "YEARLY"
  subscriptionId       String?
  subscriptionStatus   String   @default("INACTIVE") // "ACTIVE" | "CANCELLED" | "HALTED" | "EXPIRED" | "INACTIVE"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members     OrganizationMember[]
  invitations Invitation[]
  folders     Folder[]
  videos      Video[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  paymentOrders PaymentOrder[]
  sharePageConfig SharePageConfig?
  meetings    Meeting[]
  playlists   Playlist[]
  offeringsConfig OfferingsPageConfig?
  offeringItems   OfferingItem[]
  offeringInquiries OfferingInquiry[]
  contentPurchases ContentPurchase[]
  bankAccount     BankAccount?
  withdrawalRequests WithdrawalRequest[]
}

model SharePageConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Appearance & Styling
  themePreset      String       @default("obsidian") // "obsidian" | "cyberpunk" | "vaporwave" | "gold" | "ocean" | "sunset" | "minimal-light"
  accentColor      String       @default("#84cc16")
  backgroundStyle  String       @default("mesh-gradient") // "mesh-gradient" | "obsidian-aura" | "neon-grid" | "glassmorphism" | "minimal-solid"
  cardRoundness    String       @default("3xl") // "xl" | "3xl" | "pill" | "square"

  // Header & Branding
  customTitle            String?
  welcomeTagline         String?
  welcomeTaglineFontSize String       @default("xl") // "sm" | "md" | "lg" | "xl" | "2xl"
  showLogo               Boolean      @default(true)
  customLogoKey          String?      // S3 Key: share-page-customisation/{orgId}/logo-{timestamp}.png
  welcomeBannerKey       String?      // S3 Key: share-page-customisation/{orgId}/welcome-banner-{timestamp}.png

  // Call To Action (CTA) Button
  showCta          Boolean      @default(false)
  ctaText          String?      @default("Learn More")
  ctaUrl           String?      @default("https://example.com")
  ctaStyle         String       @default("gradient") // "gradient" | "solid" | "outline"

  // Player & Display Features
  showShareButton  Boolean      @default(false)
  showSocialBar    Boolean      @default(false)
  showDuration     Boolean      @default(true)
  autoPlayMuted    Boolean      @default(false)
  footerText       String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Plan {
  id                String         @id @default(cuid())
  name              String         // "free", "pro", "enterprise"
  minutesLimit      Int            // e.g. 200 for free
  storageLimitGb    Int            @default(2) // 2GB default for free
  maxResolution     String         // "1080p", "4k", ...
  seatLimit         Int
  priceMonthlyCents Int
  isCustom          Boolean        @default(false)
  commissionPercent Float          @default(6.5) // Platform fee on sales: Free 6.5%, Basic 5.5%, Pro 4.0%, Enterprise 3.5%
  organizations     Organization[]
  paymentOrders     PaymentOrder[]
}

// --------------------------------------------------------
// Folders
// --------------------------------------------------------

model Folder {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Folder?         @relation("NestedFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children        Folder[]        @relation("NestedFolders")
  videos          Video[]
  meetings        Meeting[]
  shareAccessMode ShareAccessMode @default(PUBLIC)
  sharedEmails    SharedEmail[]

  @@unique([organizationId, parentId, name])
}

// --------------------------------------------------------
// Video Pipeline & Renditions
// --------------------------------------------------------

model Video {
  id               String      @id @default(cuid())
  organizationId   String
  uploadedByUserId String
  folderId         String?
  title            String
  description      String?
  status           VideoStatus @default(UPLOADING)
  progress         Int         @default(0)
  durationSeconds  Int?
  sizeBytes        BigInt?
  sourceWidth      Int?
  sourceHeight     Int?
  originalKey      String      // R2 object key
  thumbnailKey     String?
  spriteUrl        String?
  requireHls       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder          Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  renditions      VideoRendition[]
  shareAccessMode ShareAccessMode  @default(PUBLIC)
  price            Float?
  currency         String?          @default("USD")
  countryPricing   Json?
  sharedEmails    SharedEmail[]
  meetingRecordings Meeting[]      @relation("MeetingRecordedVideo")
  playlistItems   PlaylistItem[]
  purchases       ContentPurchase[]
}

// --------------------------------------------------------
// Playlists
// --------------------------------------------------------

model Playlist {
  id              String          @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  shareAccessMode ShareAccessMode @default(PUBLIC)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items           PlaylistItem[]
  sharedEmails    SharedEmail[]
  price           Float?
  currency        String?         @default("USD")
  countryPricing  Json?
  purchases       ContentPurchase[]

  @@index([organizationId])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, order])
}

enum VideoStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

model VideoRendition {
  id          String   @id @default(cuid())
  videoId     String
  resolution  String   // "480p" | "720p" | "1080p" | "1440p" | "4k"
  bitrateKbps Int
  storageKey  String   // R2 key for this rendition's HLS playlist/segments
  sizeBytes   BigInt   @default(0)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// API Keys & Webhooks
// --------------------------------------------------------

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  hashedKey      String    @unique
  prefix         String    // e.g. "vk_live_ab12"
  createdById    String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[] // e.g. ["video.ready", "video.failed", "usage.limit_reached"]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// Email Access Control for Shared Videos & Folders
// --------------------------------------------------------

enum ShareAccessMode {
  PUBLIC
  RESTRICTED
  PRIVATE
  PURCHASABLE
}

model SharedEmail {
  id         String    @id @default(cuid())
  videoId    String?
  folderId   String?
  playlistId String?
  email      String
  createdAt  DateTime  @default(now())

  video    Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  folder   Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([videoId, email])
  @@unique([folderId, email])
  @@unique([playlistId, email])
  @@index([email])
}

// --------------------------------------------------------
// Payments & Razorpay Integration
// --------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model PaymentOrder {
  id                     String        @id @default(cuid())
  organizationId        String
  userId                 String
  planId                 String
  gateway                String        @default("razorpay") // "razorpay" | "cashfree"
  razorpayOrderId        String?       @unique
  razorpayPaymentId      String?
  razorpaySignature      String?
  razorpaySubscriptionId String?
  cashfreeOrderId        String?       @unique
  cashfreePaymentId      String?
  cashfreeSessionId      String?
  cashfreeSubscriptionId String?       @unique
  amount                 Int           // Amount in INR paise (e.g. 99900)
  currency               String        @default("INR")
  billingMode            String        @default("ONE_TIME") // "ONE_TIME" | "RECURRING"
  billingCycle           String        @default("MONTHLY")  // "MONTHLY" | "YEARLY"
  status                 PaymentStatus @default(PENDING)
  gatewayFeeAmount       Float?        @default(0) // Actual gateway processing charges including taxes
  gatewayFeePercent      Float?        @default(0) // Effective gateway fee percentage
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([gateway])
}

// --------------------------------------------------------
// Meetings & Video Conferencing (LiveKit)
// --------------------------------------------------------

model Meeting {
  id              String          @id @default(cuid())
  organizationId  String
  createdById     String
  folderId        String?
  title           String
  description     String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  status          MeetingStatus   @default(SCHEDULED)
  isInstant       Boolean         @default(false)
  recordOnStart   Boolean         @default(false)
  allowGuests     Boolean         @default(true)
  isRecording     Boolean         @default(false)
  recordedVideoId String?
  endedAt         DateTime?
  shareAccessMode ShareAccessMode @default(PUBLIC)
  price           Float?
  currency        String?         @default("USD")
  countryPricing  Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  folder          Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  invites         MeetingInvite[]
  recordedVideo   Video?          @relation("MeetingRecordedVideo", fields: [recordedVideoId], references: [id], onDelete: SetNull)
  purchases       ContentPurchase[]

  @@index([organizationId])
  @@index([createdById])
  @@index([folderId])
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model MeetingInvite {
  id        String   @id @default(cuid())
  meetingId String
  email     String
  role      String   @default("attendee") // "host" | "co-host" | "attendee"
  status    String   @default("pending")  // "pending" | "accepted" | "declined"
  sentAt    DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
  @@index([email])
}

// --------------------------------------------------------
// Contact & Support Inquiries
// --------------------------------------------------------

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String   @default("General Inquiry")
  subject   String?
  message   String   @db.Text
  status    String   @default("PENDING") // "PENDING" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// --------------------------------------------------------
// Organization Offerings & Creator Portfolio
// --------------------------------------------------------

model OfferingsPageConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Appearance & Theme
  themePreset      String       @default("obsidian") // "obsidian" | "aurora" | "sunset" | "minimal-light" | "cyberpunk" | "rose-gold" | "emerald" | "midnight"
  accentColor      String       @default("#84cc16")
  backgroundStyle  String       @default("mesh-gradient") // "mesh-gradient" | "obsidian-aura" | "ambient-glow" | "minimal-grid" | "glassmorphism"
  cardRoundness    String       @default("2xl") // "xl" | "2xl" | "3xl" | "square"

  // Brand & Creator Profile Header
  headline         String?      @default("Master Your Craft & Scale Your Knowledge")
  subheadline      String?      @default("Courses, direct mentorship, production assets & consulting sessions.")
  bio              String?      @db.Text
  showAvatar       Boolean      @default(true)
  avatarKey        String?
  bannerKey        String?

  // Primary Call-To-Action
  ctaText          String?      @default("Explore Offerings")
  ctaAction        String?      @default("SCROLL_OFFERINGS") // "SCROLL_OFFERINGS" | "INQUIRY_MODAL" | "CONTACT_SECTION" | "FEATURED_VIDEO" | "EXTERNAL_LINK"
  ctaUrl           String?      @default("#offerings")
  secondaryCtaText String?      @default("Book 1:1 Call")
  secondaryCtaAction String?    @default("INQUIRY_MODAL") // "SCROLL_OFFERINGS" | "INQUIRY_MODAL" | "CONTACT_SECTION" | "FEATURED_VIDEO" | "EXTERNAL_LINK"
  secondaryCtaUrl  String?      @default("#meetings")

  // Social Links & Stats (Stored as JSON objects/arrays)
  socialLinks      Json?        // e.g. { youtube, twitter, github, linkedin, instagram, discord, website, twitch, email }
  stats            Json?        // e.g. [ { label: "Students", value: "12,000+" }, { label: "Rating", value: "4.9 ★" } ]
  sectionsConfig   Json?        // e.g. { showCourses: true, showMeetings: true, showVideos: true, showProducts: true, showServices: true, showTestimonials: true, showFaq: true, showContact: true }
  testimonials     Json?        // e.g. [ { name, role, company, avatar, quote, rating } ]
  faqs             Json?        // e.g. [ { question, answer } ]

  // Featured Showcase Video
  featuredVideoUrl String?

  isPublished      Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model OfferingItem {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type             String            // "PLAYLIST" | "COURSE" | "MEETING" | "VIDEO" | "PRODUCT" | "SERVICE"
  title            String
  slug             String?
  subtitle         String?
  description      String?           @db.Text
  price            String?           // e.g. "$199", "Free", "$150/hr", "₹3,499"
  pricePeriod      String?           // e.g. "one-time", "/hr", "/session", "/month"
  badge            String?           // e.g. "Bestseller", "Popular", "New", "Limited Seats"
  coverImageKey    String?
  ctaText          String?           @default("Learn More")
  ctaAction        String?           @default("INQUIRY_MODAL") // "INQUIRY_MODAL" | "EXTERNAL_LINK" | "FEATURED_VIDEO"
  ctaUrl           String?
  highlights       String[]          // e.g. ["8 Comprehensive Modules", "Certificate of Completion", "Discord Community Access"]
  meetingDuration  String?           // e.g. "45 mins", "60 mins" (for 1:1 meetings)
  deliveryFormat   String?           // e.g. "Live 1:1 Video Call", "Self-paced HD Video", "Instant Download (ZIP)"
  order            Int               @default(0)
  isFeatured       Boolean           @default(false)
  isPublished      Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  inquiries        OfferingInquiry[]

  @@index([organizationId, type])
  @@index([organizationId, order])
}

model OfferingInquiry {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  offeringItemId String?
  offeringItem   OfferingItem? @relation(fields: [offeringItemId], references: [id], onDelete: SetNull)

  name           String
  email          String
  offeringTitle  String?
  message        String        @db.Text
  preferredTime  String?
  status         String        @default("PENDING") // "PENDING" | "CONTACTED" | "RESOLVED"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

// --------------------------------------------------------
// Content Purchases, Bank Accounts & Withdrawals
// --------------------------------------------------------

model ContentPurchase {
  id              String        @id @default(cuid())
  organizationId  String
  userId          String
  contentType     String        // "VIDEO" | "PLAYLIST" | "MEETING"
  videoId         String?
  playlistId      String?
  meetingId       String?
  amount          Float
  currency        String        @default("USD")
  countryCode     String?       // purchaser country code, e.g. "US", "IN"
  commissionPercent Float       @default(6.5) // Plan-tiered platform fee percentage at purchase
  commissionAmount Float        @default(0)   // Platform fee deducted: (amount * commissionPercent / 100)
  gatewayFeePercent Float       @default(0)   // Actual payment gateway fee percentage
  gatewayFeeAmount Float        @default(0)   // Gateway processing fee deducted: actual gateway charges including taxes
  creatorEarnings  Float        @default(0)   // Net creator earnings: (amount - commissionAmount - gatewayFeeAmount)
  planSnapshot    String?       // Creator's plan at purchase time, e.g. "FREE", "BASIC", "PRO", "ENTERPRISE"
  paymentMethod   String?       @default("CARD") // "CARD" | "RAZORPAY" | "CASHFREE" | "STRIPE" | "TEST_PAY"
  paymentId       String?       // reference ID
  status          String        @default("COMPLETED") // "COMPLETED" | "PENDING" | "REFUNDED"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video?        @relation(fields: [videoId], references: [id], onDelete: SetNull)
  playlist        Playlist?     @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  meeting         Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@index([videoId])
  @@index([playlistId])
  @@index([meetingId])
  @@index([createdAt])
}

model BankAccount {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  accountHolderName String
  accountNumber     String
  routingNumber     String?      // or IFSC code
  bankName          String
  swiftCode         String?
  accountType       String?      @default("CHECKING") // "CHECKING" | "SAVINGS"
  country           String?      @default("US")
  currency          String?      @default("USD")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id             String       @id @default(cuid())
  organizationId String
  requestedById  String
  amount         Float
  currency       String       @default("USD")
  status         String       @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "REJECTED"
  bankDetails    Json?        // snapshot of bank details at time of request
  adminNotes     String?
  transactionId  String?      // e.g. UTR / Wire ref / Payment ID
  transactionProof String?    // optional transaction note or receipt link
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([status])
  @@index([createdAt])
}
