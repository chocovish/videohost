generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------
// Auth.js Standard Models (NextAuth v5)
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  viewMode             String               @default("CREATOR") // "CREATOR" | "VIEWER"
  activeOrganizationId String?
  accounts             Account[]
  sessions      Session[]
  memberships   OrganizationMember[]
  createdApiKeys ApiKey[]
  paymentOrders PaymentOrder[]
  createdMeetings Meeting[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------------------------
// Organization & Access Control
// --------------------------------------------------------

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  themeId              String   @default("lime")
  planId               String
  plan                 Plan     @relation(fields: [planId], references: [id])
  customMinutesLimit   Int?     // overrides plan.minutesLimit when set
  customStorageLimitGb Int?
  planExpiresAt        DateTime?
  billingMode          String   @default("ONE_TIME") // "ONE_TIME" | "RECURRING"
  billingCycle         String   @default("MONTHLY")  // "MONTHLY" | "YEARLY"
  subscriptionId       String?
  subscriptionStatus   String   @default("INACTIVE") // "ACTIVE" | "CANCELLED" | "HALTED" | "EXPIRED" | "INACTIVE"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members     OrganizationMember[]
  invitations Invitation[]
  folders     Folder[]
  videos      Video[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  paymentOrders PaymentOrder[]
  sharePageConfig SharePageConfig?
  meetings    Meeting[]
}

model SharePageConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Appearance & Styling
  themePreset      String       @default("obsidian") // "obsidian" | "cyberpunk" | "vaporwave" | "gold" | "ocean" | "sunset" | "minimal-light"
  accentColor      String       @default("#84cc16")
  backgroundStyle  String       @default("mesh-gradient") // "mesh-gradient" | "obsidian-aura" | "neon-grid" | "glassmorphism" | "minimal-solid"
  cardRoundness    String       @default("3xl") // "xl" | "3xl" | "pill" | "square"

  // Header & Branding
  customTitle            String?
  welcomeTagline         String?
  welcomeTaglineFontSize String       @default("xl") // "sm" | "md" | "lg" | "xl" | "2xl"
  showLogo               Boolean      @default(true)
  customLogoKey          String?      // S3 Key: share-page-customisation/{orgId}/logo-{timestamp}.png
  welcomeBannerKey       String?      // S3 Key: share-page-customisation/{orgId}/welcome-banner-{timestamp}.png

  // Call To Action (CTA) Button
  showCta          Boolean      @default(false)
  ctaText          String?      @default("Learn More")
  ctaUrl           String?      @default("https://example.com")
  ctaStyle         String       @default("gradient") // "gradient" | "solid" | "outline"

  // Player & Display Features
  showShareButton  Boolean      @default(false)
  showSocialBar    Boolean      @default(false)
  showDuration     Boolean      @default(true)
  autoPlayMuted    Boolean      @default(false)
  footerText       String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Plan {
  id                String         @id @default(cuid())
  name              String         // "free", "pro", "enterprise"
  minutesLimit      Int            // e.g. 200 for free
  storageLimitGb    Int            @default(2) // 2GB default for free
  maxResolution     String         // "1080p", "4k", ...
  seatLimit         Int
  priceMonthlyCents Int
  isCustom          Boolean        @default(false)
  organizations     Organization[]
  paymentOrders     PaymentOrder[]
}

// --------------------------------------------------------
// Folders
// --------------------------------------------------------

model Folder {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Folder?         @relation("NestedFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children        Folder[]        @relation("NestedFolders")
  videos          Video[]
  shareAccessMode ShareAccessMode @default(PUBLIC)
  sharedEmails    SharedEmail[]

  @@unique([organizationId, parentId, name])
}

// --------------------------------------------------------
// Video Pipeline & Renditions
// --------------------------------------------------------

model Video {
  id               String      @id @default(cuid())
  organizationId   String
  uploadedByUserId String
  folderId         String?
  title            String
  description      String?
  status           VideoStatus @default(UPLOADING)
  progress         Int         @default(0)
  durationSeconds  Int?
  sizeBytes        BigInt?
  sourceWidth      Int?
  sourceHeight     Int?
  originalKey      String      // R2 object key
  thumbnailKey     String?
  spriteUrl        String?
  requireHls       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder          Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  renditions      VideoRendition[]
  shareAccessMode ShareAccessMode  @default(PUBLIC)
  sharedEmails    SharedEmail[]
  meetingRecordings Meeting[]      @relation("MeetingRecordedVideo")
}

enum VideoStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

model VideoRendition {
  id          String   @id @default(cuid())
  videoId     String
  resolution  String   // "480p" | "720p" | "1080p" | "1440p" | "4k"
  bitrateKbps Int
  storageKey  String   // R2 key for this rendition's HLS playlist/segments
  sizeBytes   BigInt   @default(0)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// API Keys & Webhooks
// --------------------------------------------------------

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  hashedKey      String    @unique
  prefix         String    // e.g. "vk_live_ab12"
  createdById    String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[] // e.g. ["video.ready", "video.failed", "usage.limit_reached"]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// Email Access Control for Shared Videos & Folders
// --------------------------------------------------------

enum ShareAccessMode {
  PUBLIC
  RESTRICTED
  PRIVATE
}

model SharedEmail {
  id        String   @id @default(cuid())
  videoId   String?
  folderId  String?
  email     String
  createdAt DateTime @default(now())

  video  Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([videoId, email])
  @@unique([folderId, email])
  @@index([email])
}

// --------------------------------------------------------
// Payments & Razorpay Integration
// --------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model PaymentOrder {
  id                String        @id @default(cuid())
  organizationId   String
  userId            String
  planId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int           // Amount in INR paise (e.g. 99900)
  currency          String        @default("INR")
  billingMode       String        @default("ONE_TIME") // "ONE_TIME" | "RECURRING"
  billingCycle      String        @default("MONTHLY")  // "MONTHLY" | "YEARLY"
  razorpaySubscriptionId String?
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

// --------------------------------------------------------
// Meetings & Video Conferencing (LiveKit)
// --------------------------------------------------------

model Meeting {
  id              String        @id @default(cuid())
  organizationId  String
  createdById     String
  code            String        @unique
  title           String
  description     String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  status          MeetingStatus @default(SCHEDULED)
  isInstant       Boolean       @default(false)
  recordOnStart   Boolean       @default(false)
  allowGuests     Boolean       @default(true)
  isRecording     Boolean       @default(false)
  recordingId     String?       // Egress ID or session recording ID
  recordedVideoId String?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  invites         MeetingInvite[]
  recordedVideo   Video?        @relation("MeetingRecordedVideo", fields: [recordedVideoId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdById])
  @@index([code])
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model MeetingInvite {
  id        String   @id @default(cuid())
  meetingId String
  email     String
  role      String   @default("attendee") // "host" | "co-host" | "attendee"
  status    String   @default("pending")  // "pending" | "accepted" | "declined"
  sentAt    DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
  @@index([email])
}



