# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:passpass@localhost:5432/videohost?schema=public"

# Application Base URL
APP_URL="http://localhost:3000"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudflare R2 / MinIO Storage Credentials
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="passpass"
R2_BUCKET_NAME="videohost"
DELETE_S3_ON_VIDEO_DELETE="true"

# Job Queue Redis Connection
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Worker Execution Concurrency
WORKER_CONCURRENCY="2"
HLS_RENDITION_RESOLUTIONS="480,720,1080,2160"

# Docker Container Worker Configuration
CONTAINER_WORKER_URL="http://localhost:8080"
WORKER_SECRET_TOKEN="your-worker-secret-token"
PORT="8080"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_example12345"
RAZORPAY_KEY_SECRET="example_secret_key_12345"
RAZORPAY_WEBHOOK_SECRET="example_webhook_secret_12345"
# LiveKit Video Conferencing & Real-Time Meetings (Self-Hosted or Cloud)
LIVEKIT_URL="ws://127.0.0.1:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"


