# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:passpass@localhost:5432/videohost?schema=public"

# Application Base URL
APP_URL="http://localhost:3000"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudflare R2 / MinIO Storage Credentials
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="passpass"
R2_BUCKET_NAME="videohost"
DELETE_S3_ON_VIDEO_DELETE="true"

# Public CDN Custom Domain or Local Storage Proxy Host
NEXT_PUBLIC_CDN_HOST="http://localhost:9000/videohost"

# Job Queue Redis Connection
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Worker Execution Concurrency
WORKER_CONCURRENCY="2"

# Docker Container Worker Configuration
CONTAINER_WORKER_URL="http://localhost:8080"
WORKER_SECRET_TOKEN="your-worker-secret-token"
CUSTOM_WORKER_CALLBACK_URL=""
PORT="8080"

