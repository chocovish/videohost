# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:passpass@localhost:5432/videohost?schema=public"

# Application Base URL
APP_URL="http://localhost:3000"

# Auth.js / NextAuth Configuration
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Video Storage Provider ("s3" | "bunny") – controls upload & playback pipeline
# s3    = Cloudflare R2 / MinIO via presigned URLs + FFmpeg worker (default)
# bunny = Bunny.net Stream – auto-transcode, collections per organization
VIDEO_STORAGE="s3"

# Cloudflare R2 / MinIO Storage Credentials (used when VIDEO_STORAGE=s3)
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="passpass"
R2_BUCKET_NAME="videohost"
DELETE_S3_ON_VIDEO_DELETE="true"

# Bunny.net Stream Credentials (used when VIDEO_STORAGE=bunny)
# Get these from https://dash.bunny.net → Stream → Your Library → API
BUNNY_LIBRARY_ID="12345"
BUNNY_API_KEY="your-bunny-stream-api-key"
# Read-only key for webhook signature verification (if empty, BUNNY_API_KEY is used)
BUNNY_READONLY_API_KEY="your-bunny-readonly-api-key"
# Optional: pull-zone / CDN hostname for direct HLS playback
# e.g. vz-123456.b-cdn.net  (if omitted, iframe.mediadelivery.net embed is used)
BUNNY_CDN_HOSTNAME="vz-123456.b-cdn.net"
BUNNY_EMBED_HOSTNAME="iframe.mediadelivery.net"
# Webhook: configure this exact URL in Bunny Dashboard → Stream → Library → Webhook URL
# or via Core API: POST https://api.bunny.net/videolibrary/{id} { WebhookUrl }
BUNNY_WEBHOOK_URL="https://yourdomain.com/api/bunny/webhook"

# Streaming Playback Mode ("dash" | "hls")
STREAMING_PROTOCOL="dash"

# HLS & DASH Segment Duration in seconds (0 = single file byte-range stream, >0 = individual chunk segments e.g. 6)
STREAMING_SEGMENTS="0"

# Job Queue Redis Connection
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Worker Execution Concurrency
WORKER_CONCURRENCY="2"
# Number of CPU threads/cores for FFmpeg worker transcoding (0 = use all available cores, >0 = specific core count)
WORKER_CORE="0"
# Max videos processed at the same time by the transcoder queue
WORKER_MAX_CONCURRENT_JOBS="2"
RENDITION_RESOLUTIONS="480,720,1080,2160"

# Docker Container Worker Configuration
CONTAINER_WORKER_URL="http://localhost:8080"
WORKER_SECRET_TOKEN="your-worker-secret-token"
PORT="8080"

# Payment Gateway Selection ("razorpay" | "cashfree")
NEXT_PUBLIC_PAYMENT_GATEWAY="razorpay"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_example12345"
RAZORPAY_KEY_SECRET="example_secret_key_12345"
RAZORPAY_WEBHOOK_SECRET="example_webhook_secret_12345"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_example12345"

# Cashfree Payment Gateway Configuration (API v6 / 2026-01-01)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_API_VERSION="2026-01-01"
NEXT_PUBLIC_CASHFREE_ENV="SANDBOX"
# LiveKit Video Conferencing & Real-Time Meetings (Self-Hosted or Cloud)
LIVEKIT_URL="ws://127.0.0.1:7880"
LIVEKIT_INTERNAL_URL="ws://livekit:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
EGRESS_URL="http://host.docker.internal:3000"

# Admin Dashboard Password (Separate Route /admin)
ADMIN_PASSWORD="admin123"


